generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum Status {
  PUBLISHED
  SOLD
}

model Book {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  price       Float
  author      String
  status      Status    @default(PUBLISHED)
  ownerId     Int
  user        User      @relation(fields: [ownerId], references: [id])
  soldAt      DateTime? 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  book        Book[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}