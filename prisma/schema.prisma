generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float
  author      String
  status      String
  ownerId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
